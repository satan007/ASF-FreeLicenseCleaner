<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<!-- Versions come from ArchiSteamFarm's own Directory.Packages.props (central package management). -->
		<PackageReference Include="AngleSharp" IncludeAssets="compile" />
		<PackageReference Include="SteamKit2" IncludeAssets="compile" />
		<PackageReference Include="System.Composition.AttributedModel" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
		<!--
			This assumes the standard ASF-PluginTemplate layout, where the
			ArchiSteamFarm source is checked out as a git submodule next to
			this project (see README.md). ExcludeAssets="all" + Private="false"
			mirrors ASF's own ExamplePlugin.csproj: we compile against ASF's
			types but do not bundle ASF itself into our output, since the
			plugin is loaded *into* an already-running ASF process.
		-->
		<ProjectReference Include="..\ArchiSteamFarm\ArchiSteamFarm.csproj" ExcludeAssets="all" Private="false" />
	</ItemGroup>
</Project>
