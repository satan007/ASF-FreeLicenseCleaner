<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Versions come from ArchiSteamFarm's own Directory.Packages.props
			(imported via the repo-root Directory.Packages.props).

			JetBrains.Annotations.Sources and Microsoft.AspNetCore.OpenApi
			are not used by our code directly, but ASF's shared build
			settings run an OpenApi XML-comment source generator against
			every project - without these two references the generated
			code fails to compile (CS0246/CS0234 on OpenApiSchema and
			friends), exactly like in ExamplePlugin.csproj and
			ASF-PluginTemplate's MyAwesomePlugin.csproj.
		-->
		<PackageReference Include="AngleSharp" IncludeAssets="compile" />
		<PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" IncludeAssets="compile" />
		<PackageReference Include="SteamKit2" IncludeAssets="compile" />
		<PackageReference Include="System.Composition.AttributedModel" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
		<!--
			ArchiSteamFarm is checked out as a git submodule at the repo
			root (see .gitmodules), so from here it's ..\ArchiSteamFarm\
			(submodule root) \ArchiSteamFarm\ (the actual project folder
			inside the ASF repo) \ArchiSteamFarm.csproj - same two-level
			nesting as ASF-PluginTemplate. ExcludeAssets="all" +
			Private="false" mirrors ASF's own ExamplePlugin.csproj: we
			compile against ASF's types but do not bundle ASF itself into
			our output, since the plugin is loaded *into* an
			already-running ASF process.
		-->
		<ProjectReference Include="..\ArchiSteamFarm\ArchiSteamFarm\ArchiSteamFarm.csproj" ExcludeAssets="all" Private="false" />
	</ItemGroup>

	<!-- Convenience for local testing: drop the built plugin straight into the submodule's own ASF binary output. -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Copy SourceFolders="$(TargetDir)" DestinationFolder="..\ArchiSteamFarm\ArchiSteamFarm\bin\$(Configuration)\$(TargetFramework)\plugins\$(AssemblyName)\" SkipUnchangedFiles="true" />
	</Target>
</Project>
